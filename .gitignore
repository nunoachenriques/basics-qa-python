/**/__pycache__/
/.idea/
/.vscode/
/.venv/
/build/
/dist/
/*.egg-info/
.coverage
# Coverage writes one file per process when measuring subprocesses, named
# .coverage.<host>.<pid>.<random>, which the bare name above does not match.
.coverage.*
coverage.xml
/htmlcov/
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
# uv's cache, when a pipeline is told to keep it inside the project so it
# can be cached between runs (see .gitlab-ci.yml).
/.uv-cache/
# Generated by the security and package stages, and rebuilt on every run.
/sbom.cyclonedx.json
/requirements.lock.txt
/wheel.txt
# Never commit secrets. Listed even though nothing here reads a .env file:
# this template is copied into projects that will, and the cost of the line
# is nothing next to the cost of the mistake.
.env
.env.*
