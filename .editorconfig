# https://editorconfig.org - keeps editors consistent with ruff's formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown (hard line break).
trim_trailing_whitespace = false
